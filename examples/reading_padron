  "position": {
    "description": "Lectura situada de las condiciones administrativas mediante las cuales el acceso y la inscripción al padrón son formulados, probados, limitados, desplazados o absorbidos dentro del procedimiento. La lectura registra operaciones de fijación, omisión, banalización, deriva y desactivación por extensión en fragmentos documentales concretos, sin atribuirlas como propiedades inherentes del texto."
  },
  "grid": {
    "operations": [
      "fijacion",
      "omision",
      "banalizacion",
      "deriva",
      "desactivacion_extension"
    ],
    "operation_definitions": {
      "fijacion": "Estabilización explícita de una condición, categoría, prueba, procedimiento, sujeto o criterio mediante una forma administrativa determinada.",
      "omision": "Aspecto pertinente para el objeto de la lectura que queda fuera de formulación, fuera de resolución o sin tratamiento explícito en el fragmento considerado.",
      "banalizacion": "Integración de una dificultad, asimetría o restricción material como elemento ordinario del procedimiento, sin tratarla como conflicto específico.",
      "deriva": "Desplazamiento del tratamiento de un problema hacia otra categoría, procedimiento, autoridad, documento o registro administrativo.",
      "desactivacion_extension": "Absorción de una tensión o restricción mediante la ampliación, precisión o multiplicación de modalidades administrativas que la incorporan a la lógica del dispositivo."
    },
    "estimated_dimensions": {
      "formalization": {
        "range": [
          0,
          1
        ],
        "epistemic_status": "estimado",
        "description": "Coordenada interpretativa continua producida por la lectura para situar de forma relativa el grado de formalización administrativa de cada fragmento. Los valores se distribuyen comparativamente sobre el continuo 0–1 para hacer gráficamente inspeccionables las diferencias internas de la lectura. Expresan una estimación situada y deliberadamente subjetiva; no constituyen una medida objetiva ni una propiedad inherente del texto."
      }
    }
  },
